@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h3 class="mb-0">Acesso ao Sistema</h3>
            </div>
            <div class="card-body">
                
                @if (ViewBag.Erro != null)
                {
                    <div class="alert alert-danger text-center">
                        @ViewBag.Erro
                    </div>
                }

                <form asp-action="Login" method="post">
                    <div class="form-group mb-3">
                        <label class="form-label">E-mail</label>
                        <input name="email" type="email" class="form-control" required placeholder="Digite seu e-mail" />
                    </div>

                    <div class="form-group mb-4">
                        <label class="form-label">Senha</label>
                        <input name="senha" type="password" class="form-control" required placeholder="Digite sua senha" />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success">Entrar</button>
                    </div>
                </form>
            </div>
            <div class="card-footer text-center">
                <a asp-action="Cadastro" class="text-decoration-none">Ainda não tem conta? Cadastre-se aqui!</a>
            </div>
        </div>
    </div>
</div>