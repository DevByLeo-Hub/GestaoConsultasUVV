@model IEnumerable<GestaoConsultasUVV.Models.Consulta>
@{
    ViewData["Title"] = "Minhas Consultas";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
    <h2>Minhas Consultas</h2>
    <a asp-action="Create" class="btn btn-primary fw-bold">+ Agendar Consulta</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Especialidade</th>
                    <th>Data e Hora</th>
                    <th>Descrição</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">
                            <em>Você ainda não possui consultas agendadas.</em>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle fw-bold">@item.Especialidade</td>
                            <td class="align-middle">@item.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="align-middle">@item.Descricao</td>
                            <td class="text-center align-middle">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger ms-1">Cancelar</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>