@model GestaoConsultasUVV.Models.Consulta
@{
    ViewData["Title"] = "Cancelar Consulta";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="alert alert-danger shadow-sm">
            <h4 class="alert-heading fw-bold">Atenção!</h4>
            <p>Você tem certeza que deseja cancelar esta consulta?</p>
            <hr>
            <dl class="row mb-0">
                <dt class="col-sm-4">Especialidade:</dt>
                <dd class="col-sm-8 fw-bold">@Model.Especialidade</dd>

                <dt class="col-sm-4">Data e Hora:</dt>
                <dd class="col-sm-8">@Model.DataHora.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-4">Descrição:</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Descricao) ? "Nenhuma" : Model.Descricao)</dd>
            </dl>
        </div>

        <div class="d-flex justify-content-center mt-3">
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-secondary me-3">Não, Voltar</a>
                <button type="submit" class="btn btn-danger fw-bold">Sim, Cancelar Consulta</button>
            </form>
        </div>
    </div>
</div>