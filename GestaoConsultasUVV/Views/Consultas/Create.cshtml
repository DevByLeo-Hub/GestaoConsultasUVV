@model GestaoConsultasUVV.Models.Consulta
@{
    ViewData["Title"] = "Agendar Consulta";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-primary">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Nova Consulta</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div class="mb-3">
                        <label asp-for="Especialidade" class="form-label fw-bold">Especialidade</label>
                        <input asp-for="Especialidade" class="form-control" placeholder="Ex: Cardiologia, Clínico Geral..." />
                        <span asp-validation-for="Especialidade" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DataHora" class="form-label fw-bold">Data e Hora</label>
                        <input asp-for="DataHora" class="form-control" type="datetime-local" />
                        <span asp-validation-for="DataHora" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Descricao" class="form-label fw-bold">Descrição (Opcional)</label>
                        <textarea asp-for="Descricao" class="form-control" rows="3" placeholder="Alguma observação para o médico?"></textarea>
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                        <button type="submit" class="btn btn-success fw-bold">Agendar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>